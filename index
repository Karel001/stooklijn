<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Weersafhankelijke regeling v5</title><style>
:root{font-family:system-ui;color:#17324b;background:#eef3f7}*{box-sizing:border-box}body{margin:0}.wrap{max-width:1320px;margin:auto;padding:18px}.grid{display:grid;grid-template-columns:315px 1fr;gap:16px}.card{background:#fff;border-radius:12px;padding:15px;margin-bottom:14px;box-shadow:0 3px 14px #0001}label{display:block;margin:11px 0 4px;font-weight:650}.val{float:right;color:#0877b9}input[type=range]{width:100%}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.kpi{background:#f2f8fb;padding:9px;border-radius:8px;font-size:.8rem}.kpi b{display:block;color:#0877b9;font-size:1.2rem}.charts{display:grid;grid-template-columns:1fr 1fr;gap:12px}canvas{width:100%;height:265px;border:1px solid #dce7ee;border-radius:7px;background:#fff}.btn{border:0;border-radius:7px;padding:9px 12px;background:#0877b9;color:#fff;margin:5px 5px 0 0}.orange{background:#d26b35}.note{font-size:.88rem;color:#587086}.manual{padding:9px;background:#fff8ef;border-left:4px solid #d26b35}.scroll{overflow-x:auto}@media(max-width:900px){.grid,.charts{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}}</style></head><body><div class="wrap"><h1>Simulator weersafhankelijke regeling</h1><p class="note">Stooklijn → ruimtecompensatie → PI-regelaar → mengkraan → vertrektemperatuur.</p><div class="grid"><aside>
<div class="card"><h3>Stooklijn en ruimte</h3><label>Buitentemperatuur <span id="oTout" class="val"></span></label><input id="tout" type="range" min="-10" max="20" step=".5" value="5"><label>Ruimtesetpunt <span id="oRset" class="val"></span></label><input id="rset" type="range" min="16" max="24" step=".5" value="20"><label>Gemeten ruimtetemperatuur <span id="oRoomPV" class="val"></span></label><input id="roompv" type="range" min="14" max="26" step=".1" value="19"><label><input id="manualroom" type="checkbox" checked> PV ruimte handmatig instellen</label><p class="note">Uitgevinkt: de ruimtetemperatuur volgt opnieuw het thermische gebouwmodel.</p><label>Helling <span id="oSlope" class="val"></span></label><input id="slope" type="range" min=".2" max="2.5" step=".1" value="1.5"><label>Basispunt bij 20 °C buiten <span id="oBase" class="val"></span></label><input id="base" type="range" min="15" max="40" step="1" value="20"><label><input id="comp" type="checkbox" checked> ruimtecompensatie</label><label>Beïnvloedingsfactor v <span id="oV" class="val"></span></label><input id="vf" type="range" min="0" max="4" step=".1" value="1.5"></div>
<div class="card"><h3>PI en proces</h3><label>Kp <span id="oKp" class="val"></span></label><input id="kp" type="range" min=".5" max="25" step=".5" value="5"><label>Ti <span id="oTi" class="val"></span></label><input id="ti" type="range" min="20" max="1800" step="20" value="600"><label>Kleplooptijd <span id="oRun" class="val"></span></label><input id="runtime" type="range" min="20" max="300" step="10" value="120"><label>Procesvertraging vertrek <span id="oLag" class="val"></span></label><input id="lag" type="range" min="20" max="300" step="10" value="90"></div>
<div class="card"><h3>Verstoring vertrektemperatuur</h3><label>Verstoring <span id="oDist" class="val"></span></label><input id="dist" type="range" min="-20" max="20" step="1" value="0"><button id="cold" class="btn orange">−10 K stap</button><button id="clear" class="btn">Verstoring weg</button><br><button id="pause" class="btn">Pauze</button><button id="reset" class="btn">Reset</button></div></aside>
<main><div class="card kpis"><div class="kpi">SP vertrek<b id="kSP"></b></div><div class="kpi">PV vertrek<b id="kPV"></b></div><div class="kpi">Regelfout<b id="kE"></b></div><div class="kpi">PI-uitgang<b id="kU"></b></div><div class="kpi">Klepstand<b id="kY"></b></div><div class="kpi">PV ruimte<b id="kRoom"></b></div></div>
<div class="card scroll"><h3>Regelkring volgens het cursusschema</h3><svg viewBox="0 0 1180 420" style="width:100%;min-width:950px"><defs><marker id="a" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8z" fill="#17324b"/></marker></defs><style>.l{fill:none;stroke:#17324b;stroke-width:2;marker-end:url(#a)}.f{fill:none;stroke:#d26b35;stroke-width:2;marker-end:url(#a)}.b,.c{fill:#f8fcff;stroke:#17324b;stroke-width:2}.c{fill:white}.t{font:15px system-ui;fill:#17324b}.sm{font:12px system-ui;fill:#587086}.v{font:bold 14px system-ui;fill:#0877b9}</style><text x="20" y="80" class="t">T buiten</text><text id="sTout" x="20" y="103" class="v"/><path class="l" d="M90 85H190"/><circle class="c" cx="205" cy="85" r="15"/><text x="199" y="78" class="t">+</text><text x="199" y="105" class="t">−</text><path class="l" d="M220 85H270"/><rect class="b" x="270" y="50" width="155" height="70"/><text x="302" y="78" class="t">STOOKLIJN</text><text id="sCurve" x="320" y="105" class="v"/><path class="l" d="M425 85H505"/><circle class="c" cx="520" cy="85" r="15"/><text x="514" y="78" class="t">+</text><text x="514" y="105" class="t">+</text><text x="548" y="62" class="sm">SP vertrek</text><text id="sSP" x="548" y="82" class="v"/><path class="l" d="M535 85H650"/><circle class="c" cx="665" cy="85" r="15"/><text x="659" y="78" class="t">+</text><text x="659" y="105" class="t">−</text><text x="690" y="61" class="sm">regelafwijking</text><text id="sE" x="690" y="81" class="v"/><path class="l" d="M680 85H770"/><rect class="b" x="770" y="50" width="130" height="70"/><text x="795" y="77" class="t">PI-regelaar</text><text id="sU" x="812" y="103" class="v"/><path class="l" d="M900 85H955"/><rect class="b" x="955" y="50" width="145" height="70"/><text x="978" y="76" class="t">Mengkraan</text><text id="sY" x="1005" y="103" class="v"/>
<text x="20" y="255" class="t">SP ruimte</text><text id="sRoomSP" x="20" y="278" class="v"/><path class="l" d="M100 260H170"/><circle class="c" cx="185" cy="260" r="15"/><text x="179" y="253" class="t">+</text><text x="179" y="280" class="t">−</text><text x="20" y="345" class="t">PV ruimte</text><text id="sRoomPV" x="20" y="368" class="v"/><path class="f" d="M105 350H185V275"/><path class="l" d="M200 260H235"/><rect class="b" x="235" y="225" width="145" height="70"/><text x="255" y="252" class="t">v · (SP − PV)</text><text id="sVDiff" x="283" y="279" class="v"/><path class="l" d="M380 260H445"/><circle class="c" cx="460" cy="260" r="15"/><text x="454" y="253" class="t">+</text><text x="487" y="236" class="sm">Intern SP ruimte</text><text id="sInternal" x="487" y="258" class="v"/><path class="l" d="M460 245V170H205V100"/><text x="350" y="160" class="sm">20 °C referentie</text><path class="l" d="M475 260H520V100"/><text x="535" y="170" class="sm">ΔSP ruimte t.o.v. 20 °C</text><text x="694" y="345" class="t">PV vertrek</text><text id="sPV" x="694" y="368" class="v"/><path class="f" d="M770 350H665V100"/><text x="955" y="190" class="t">Verstoring vertrek</text><text id="sDist" x="990" y="213" class="v"/><path class="f" d="M1025 220V120"/></svg></div>
<div class="charts"><div class="card"><h3>Stooklijn</h3><canvas id="curve" width="540" height="265"></canvas></div><div class="card"><h3>Temperaturen in de tijd</h3><canvas id="temp" width="540" height="265"></canvas><p class="note">Blauw: PV vertrek · grijs: SP vertrek · oranje: PV ruimte</p></div></div><div class="card"><h3>PI-uitgang en klepstand</h3><canvas id="ctrl" width="1080" height="245"></canvas></div></main></div></div><script>
const $=x=>document.getElementById(x),n=x=>+$(x).value,C=(x,a,b)=>Math.max(a,Math.min(b,x));let S={flow:30,room:19,I:0,u:0,y:20,t:0},H=[],running=true;function roomPV(){return $('manualroom').checked?n('roompv'):S.room}function baseCurve(T=n('tout')){let sl=n('slope'),set=n('rset');return n('base')+sl*(20-T)+(1+sl)*(set-20)}function calc(){let sl=n('slope'),set=n('rset'),rp=roomPV(),vc=$('comp').checked?n('vf')*(set-rp):0,internal=set+vc,curve=baseCurve(),delta=(1+sl)*(internal-set),sp=C(curve+delta,15,75);return{curve,vc,internal,delta,sp,rp}}
function step(dt){let c=calc(),e=c.sp-S.flow,K=n('kp'),Ti=n('ti'),P=K*e,tr=S.I+K*e/Ti*dt,raw=P+tr;if((raw>0&&raw<100)||(raw>=100&&e<0)||(raw<=0&&e>0))S.I=tr;S.u=C(P+S.I,0,100);let mv=100/n('runtime')*dt;S.y+=C(S.u-S.y,-mv,mv);let target=22+(70-22)*S.y/100+n('dist');S.flow+=(target-S.flow)*dt/n('lag');let ret=Math.max(S.room+2,S.flow-10),q=Math.max(0,105*(S.flow+ret-2*S.room)),loss=250*(S.room-n('tout'));S.room+=(q+300-loss)*dt/7.5e6;S.t+=dt;if(S.t%5<dt){H.push([S.t/60,S.flow,c.sp,c.rp,S.u,S.y]);if(H.length>360)H.shift()}let V={kSP:c.sp.toFixed(1)+' °C',kPV:S.flow.toFixed(1)+' °C',kE:e.toFixed(1)+' K',kU:S.u.toFixed(0)+' %',kY:S.y.toFixed(0)+' %',kRoom:c.rp.toFixed(1)+' °C',sTout:n('tout').toFixed(1)+' °C',sCurve:c.curve.toFixed(1)+' °C',sSP:c.sp.toFixed(1)+' °C',sE:e.toFixed(1)+' K',sU:S.u.toFixed(0)+' %',sY:S.y.toFixed(0)+' %',sRoomSP:n('rset').toFixed(1)+' °C',sRoomPV:c.rp.toFixed(1)+' °C',sVDiff:(c.vc>=0?'+':'')+c.vc.toFixed(1)+' K',sInternal:c.internal.toFixed(1)+' °C',sPV:S.flow.toFixed(1)+' °C',sDist:(n('dist')>=0?'+':'')+n('dist')+' K'};for(let k in V)$(k).textContent=V[k]}
function ax(id,x0,x1,lo,hi){let c=$(id),g=c.getContext('2d'),W=c.width,H=c.height,p=38;g.clearRect(0,0,W,H);g.strokeStyle='#9eb1bd';g.beginPath();g.moveTo(p,8);g.lineTo(p,H-p);g.lineTo(W-7,H-p);g.stroke();return{g,X:x=>p+(x-x0)/(x1-x0)*(W-p-10),Y:y=>H-p-(y-lo)/(hi-lo)*(H-p-15)}}function ln(a,j,col){a.g.strokeStyle=col;a.g.lineWidth=2;a.g.beginPath();H.forEach((r,i)=>i?a.g.lineTo(a.X(r[0]),a.Y(r[j])):a.g.moveTo(a.X(r[0]),a.Y(r[j])));a.g.stroke()}function draw(){let c=ax('curve',-10,20,15,75);c.g.strokeStyle='#0877b9';c.g.lineWidth=3;c.g.beginPath();for(let x=-10;x<=20;x+=.5){let y=baseCurve(x);x===-10?c.g.moveTo(c.X(x),c.Y(y)):c.g.lineTo(c.X(x),c.Y(y))}c.g.stroke();c.g.fillStyle='#d9473f';c.g.beginPath();c.g.arc(c.X(n('tout')),c.Y(baseCurve()),5,0,7);c.g.fill();let x0=Math.max(0,S.t/60-30),x1=Math.max(30,S.t/60),a=ax('temp',x0,x1,15,75);ln(a,1,'#0877b9');ln(a,2,'#777');ln(a,3,'#e67e22');let b=ax('ctrl',x0,x1,0,100);ln(b,4,'#7e57c2');ln(b,5,'#2e9b55')}
function labels(){let V={oTout:n('tout').toFixed(1)+' °C',oRset:n('rset').toFixed(1)+' °C',oRoomPV:n('roompv').toFixed(1)+' °C',oSlope:n('slope').toFixed(1),oBase:n('base')+' °C',oV:n('vf').toFixed(1),oKp:n('kp').toFixed(1),oTi:n('ti')+' s',oRun:n('runtime')+' s',oLag:n('lag')+' s',oDist:(n('dist')>=0?'+':'')+n('dist')+' K'};for(let k in V)$(k).textContent=V[k];$('roompv').disabled=!$('manualroom').checked}document.querySelectorAll('input').forEach(x=>x.oninput=labels);$('cold').onclick=()=>{$('dist').value=-10;labels()};$('clear').onclick=()=>{$('dist').value=0;labels()};$('pause').onclick=()=>{running=!running;$('pause').textContent=running?'Pauze':'Start'};$('reset').onclick=()=>{S={flow:30,room:19,I:0,u:0,y:20,t:0};H=[];$('roompv').value=19;labels()};labels();step(0);draw();setInterval(()=>{if(running)step(1);else step(0);draw()},80);
</script></body></html>
